From 75afda8c30de598cff93f85fc63c86e2ee49b0ad Mon Sep 17 00:00:00 2001
From: Chao Tzu-Hsien <danny900714@gmail.com>
Date: Fri, 16 Oct 2026 22:34:31 +0800
Subject: [PATCH] build: add safari build

---
 extension.config.js | 5 +++++
 package.json        | 1 +
 2 files changed, 6 insertions(+)

diff --git a/extension.config.js b/extension.config.js
index eafa5115..03e87ed3 100644
--- a/extension.config.js
+++ b/extension.config.js
@@ -128,6 +128,11 @@ const config = {
       excludeBrowserFlags: ["--hide-scrollbars", "--disable-component-extensions-with-background-pages"],
       startingUrl: "https://music.youtube.com/",
     },
+    safari: {
+      appName: "Better Lyrics",
+      bundleId: "org.betterlyrics.better-lyrics",
+      developmentTeam: process.env.APPLE_DEVELOPMENT_TEAM,
+    }
   },
   commands: {
     dev: {
diff --git a/package.json b/package.json
index 9d1b7e49..368ff2bf 100644
--- a/package.json
+++ b/package.json
@@ -14,6 +14,7 @@
         "build:ci": "npm run generate:locales && tsx tooling/build-and-patch.ts",
         "build:zip": "npm run generate:locales && extension build --browser all --zip",
         "build:release": "npm run generate:locales && tsx tooling/build-release-zip.ts",
+        "build:safari": "npm run generate:locales && extension build --browser safari",
         "preview": "npm run generate:locales && extension preview",
         "lint": "biome lint --write . && biome format --write .",
         "update-version": "tsx tooling/update-version.ts",
-- 
2.56.0

